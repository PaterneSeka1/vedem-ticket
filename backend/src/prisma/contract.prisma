// use prisma-next

model User {
  id       ObjectId @id @map("_id")
  username String
  password String
  @@map("users")
}

// Un seul document existe jamais dans cette collection (un seul événement
// géré par l'application, voir CLAUDE.md §4) : date/lieu configurables par
// l'admin, consultés publiquement (page d'accueil, checkout, tickets).
model EventSettings {
  id       ObjectId @id @map("_id")
  date     String
  location String

  @@map("event_settings")
}

model TicketCategory {
  id          ObjectId @id @map("_id")
  name        String
  price       Int
  currency    String
  stock       Int?
  description String?

  @@map("ticket_categories")
}

type OrderItem {
  ticketCategoryId ObjectId
  quantity         Int
}

model Order {
  id          ObjectId    @id @map("_id")
  buyerName   String
  buyerPhone  String
  buyerEmail  String?
  // Une commande peut porter sur plusieurs catégories différentes, chacune
  // avec sa propre quantité (voir CLAUDE.md §4).
  items       OrderItem[]
  totalAmount Int
  // Code de téléchargement remis à l'acheteur à la création de la commande
  // (ex. "K7M2P9QX", affiché "K7M2-P9QX") : seul moyen public de récupérer
  // les tickets, et uniquement une fois la commande `paid`. Absent sur les
  // commandes antérieures à son introduction.
  accessCode  String?
  // pending | paid | failed
  status      String
  createdAt   DateTime

  @@map("orders")
}

model Payment {
  id                ObjectId  @id @map("_id")
  orderId           ObjectId
  order             Order     @relation(fields: [orderId], references: [id])
  // WAVE | CASH
  method            String
  // pending | success | failed — un paiement WAVE reste `pending` tant que
  // l'admin n'a pas vérifié la capture envoyée par l'acheteur (PaymentProof).
  status            String
  // Hérité de l'ancienne intégration API Wave (session de checkout) — plus
  // renseigné depuis le passage au lien de paiement + capture.
  waveReference     String?
  confirmedByUserId ObjectId?
  confirmedBy       User?     @relation(fields: [confirmedByUserId], references: [id])
  confirmedAt       DateTime?
  createdAt         DateTime

  @@map("payments")
}

// Capture d'écran du paiement Wave envoyée par l'acheteur, vérifiée par
// l'admin avant confirmation. Collection séparée de `payments` pour que la
// liste des paiements (dashboard) ne charge pas les images.
model PaymentProof {
  id        ObjectId @id @map("_id")
  paymentId ObjectId
  payment   Payment  @relation(fields: [paymentId], references: [id])
  mimeType  String
  // Contenu de l'image encodé en base64 (taille plafonnée à l'upload, voir
  // PaymentsService — bien en dessous de la limite de 16 Mo d'un document).
  data      String
  createdAt DateTime

  @@map("payment_proofs")
}

model Ticket {
  id               ObjectId       @id @map("_id")
  orderId          ObjectId
  order            Order          @relation(fields: [orderId], references: [id])
  ticketCategoryId ObjectId
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  code             String         @unique
  // valid | used | cancelled
  status           String
  usedAt           DateTime?
  scannedByUserId  ObjectId?
  scannedBy        User?          @relation(fields: [scannedByUserId], references: [id])

  @@map("tickets")
}