// use prisma-next

model User {
  id       ObjectId @id @map("_id")
  username String
  password String
  @@map("users")
}

// Un seul document existe jamais dans cette collection (un seul événement
// géré par l'application, voir CLAUDE.md §4) : date/lieu configurables par
// l'admin, consultés publiquement (page d'accueil, checkout, tickets).
model EventSettings {
  id       ObjectId @id @map("_id")
  date     String
  location String

  @@map("event_settings")
}

model TicketCategory {
  id          ObjectId @id @map("_id")
  name        String
  price       Int
  currency    String
  stock       Int?
  description String?

  @@map("ticket_categories")
}

type OrderItem {
  ticketCategoryId ObjectId
  quantity         Int
}

model Order {
  id          ObjectId    @id @map("_id")
  buyerName   String
  // Optionnel : les commandes payées (Wave/espèces) l'exigent toujours au
  // niveau du DTO, mais une invitation (voir Payment.method) peut ne pas en
  // avoir.
  buyerPhone  String?
  buyerEmail  String?
  // Une commande peut porter sur plusieurs catégories différentes, chacune
  // avec sa propre quantité (voir CLAUDE.md §4).
  items       OrderItem[]
  totalAmount Int
  // pending | paid | failed
  status      String
  createdAt   DateTime

  @@map("orders")
}

model Payment {
  id                ObjectId  @id @map("_id")
  orderId           ObjectId
  order             Order     @relation(fields: [orderId], references: [id])
  // WAVE | CASH | INVITATION (ticket offert, sans paiement — voir CLAUDE.md §4)
  method            String
  // pending | success | failed
  status            String
  waveReference     String?
  confirmedByUserId ObjectId?
  confirmedBy       User?     @relation(fields: [confirmedByUserId], references: [id])
  confirmedAt       DateTime?
  createdAt         DateTime

  @@map("payments")
}

model Ticket {
  id               ObjectId       @id @map("_id")
  orderId          ObjectId
  order            Order          @relation(fields: [orderId], references: [id])
  ticketCategoryId ObjectId
  ticketCategory   TicketCategory @relation(fields: [ticketCategoryId], references: [id])
  code             String         @unique
  // valid | used | cancelled
  status           String
  usedAt           DateTime?
  scannedByUserId  ObjectId?
  scannedBy        User?          @relation(fields: [scannedByUserId], references: [id])

  @@map("tickets")
}