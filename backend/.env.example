# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for MongoDB.
# Requires MongoDB >= 8.0.

# Standalone local mongod / `docker run mongo:8` — no replica set required for first-run queries.
# Transactions and change streams need a replica set; add ?replicaSet=... only after initiating one.

DATABASE_URL="mongodb://user:password@localhost:27017/mydb"

# Secret used to sign the admin JWT. Generate one with `openssl rand -base64 48`.
JWT_SECRET="change-me"
# Optional — how long a login stays valid (jsonwebtoken "zeit/ms" format). Defaults to 12h.
JWT_EXPIRES_IN="12h"

# Only used by `npm run seed:admin` to create/update the single admin account.
# Not read by the running application.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Wave (mobile money) — https://docs.wave.com/checkout
# Clé API secrète du compte marchand Wave (Bearer token pour l'API Checkout).
WAVE_API_KEY="wave_sn_prod_xxx_or_sandbox"
# Secret webhook fourni par Wave à l'enregistrement (commence par wave_sn_WHS_...).
WAVE_WEBHOOK_SECRET="wave_sn_WHS_xxx"
# Base HTTPS du frontend, utilisée pour construire les success_url/error_url
# du checkout Wave (Wave exige des URLs HTTPS — pas de localhost en pratique).
FRONTEND_BASE_URL="https://example.com"

# Dev uniquement — identifiants marchand Wave pas encore fournis : "1" fait
# sauter l'appel réel à l'API Wave (POST /payments/wave/checkout) et active
# POST /payments/wave/simulate/:paymentId pour rejouer localement le webhook
# et tester tout le parcours (commande -> paiement -> tickets) sans clé Wave
# ni déploiement. À NE JAMAIS mettre à "1" en production.
# WAVE_SIMULATE="1"

# Origines autorisées en CORS, séparées par des virgules (ex: le domaine du
# frontend en prod). Non défini = tout le monde autorisé (pratique tant qu'il
# n'y a pas de frontend ; à restreindre une fois celui-ci en place).
# CORS_ORIGIN="https://example.com,https://admin.example.com"

# À mettre à "1" seulement si le backend tourne réellement derrière un reverse
# proxy de confiance (OVH, etc.) — sinon un client pourrait usurper son IP via
# X-Forwarded-For et contourner le rate-limiting.
# TRUST_PROXY="1"

# Documentation Swagger/OpenAPI, servie sur /docs (activée par défaut).
# Mettre à "0" pour la désactiver (ex: en production).
# SWAGGER_ENABLED="0"

# Observabilité (@nestjs/observe) — traces, métriques, télémétrie d'erreurs.
# Optionnel : tant que les deux ne sont pas définies, le module n'est pas
# chargé (pas de tentative d'envoi, pas de rejet 401 au démarrage).
# Clé/secret émis ensemble sur https://observe.nestjs.com lors de la création
# du service.
# OBSERVE_APP_KEY="..."
# OBSERVE_APP_SECRET="..."
